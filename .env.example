# Só para o MODO DESENVOLVEDOR (terminal sem --usuario).
# Na janela normal, cada pessoa cria a própria conta e cola a chave lá.
# Copie este arquivo para ".env". O .env NUNCA vai para o GitHub.

# Chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=

USER_NAME=
DEFAULT_CITY=Campo Grande
VOICE_NAME=Kore

# Opcional: modelos (o primeiro que funcionar é usado)
# TEXT_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# LIVE_MODEL=gemini-3.1-flash-live-preview
